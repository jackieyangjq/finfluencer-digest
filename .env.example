# Copy to .env next to config.yaml and fill in values without quotes; never commit .env.
# In GitHub Actions, store each value as a repository secret instead (see deploy/README.md).

# Required. Gemini API key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required. Gmail address that sends the digest; the account needs 2-Step Verification for the app password below
GMAIL_ADDRESS=
# Required. 16-character Gmail app password for that address: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Optional. Recipients, comma-separated; defaults to GMAIL_ADDRESS
EMAIL_TO=
# Optional. Tickers you follow, comma-separated (e.g. NVDA,TSLA); bloggers' views on them get their own section
WATCHLIST=
# Optional. YouTube Data API v3 key, used only when channel RSS feeds fail: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Optional, portfolio section. Finnhub key for US company news (free tier works): https://finnhub.io/register
FINNHUB_API_KEY=
# Optional, portfolio section. Longbridge OpenAPI app key for live quotes and news: https://open.longbridge.com/en/
LONGBRIDGE_APP_KEY=
# Optional, portfolio section. Longbridge OpenAPI app secret, from the same developer console: https://open.longbridge.com/en/
LONGBRIDGE_APP_SECRET=
# Optional, portfolio section. Longbridge OpenAPI access token (expires, up to 90 days; the digest warns 14 days ahead): https://open.longbridge.com/en/
LONGBRIDGE_ACCESS_TOKEN=
